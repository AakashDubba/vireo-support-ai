# Vireo Audio — .env.example
# Copy to .env and fill in your secrets.
# DO NOT COMMIT .env to Git.
#
# Groq setup: https://console.groq.com/keys

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Groq API key — NEVER commit the real value
LLM_API_KEY=

# Groq pricing per 1M tokens (as of 2026-10)
LLM_PRICE_PER_1M_INPUT=0.075
LLM_PRICE_PER_1M_OUTPUT=0.30

# Currency conversion (used for INR cost projections only)
USD_TO_INR=84.0
